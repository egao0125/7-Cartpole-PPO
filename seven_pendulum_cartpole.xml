<mujoco model="seven_pendulum_cartpole">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4">
    <flag energy="enable"/>
  </option>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
    <map force="0.2" zfar="30"/>
  </visual>

  <default>
    <joint damping="0.015" armature="0.002"/>
    <geom contype="0" conaffinity="0" friction="0.9 0.01 0.001"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.12 0.12 0.12" rgb2="0.18 0.18 0.18"/>
    <material name="floor" texture="grid" texrepeat="5 5" reflectance="0.15"/>
    <material name="cart" rgba="0.0 0.78 0.88 1"/>
    <material name="cart_trim" rgba="1.0 0.86 0.12 1"/>
    <material name="eye_white" rgba="1 1 1 1"/>
    <material name="eye_dark" rgba="0.02 0.02 0.03 1"/>
    <material name="smile" rgba="1.0 0.18 0.28 1"/>
    <material name="link_a" rgba="1.0 0.44 0.18 1"/>
    <material name="link_b" rgba="0.08 0.72 0.48 1"/>
    <material name="link_c" rgba="0.50 0.42 1.0 1"/>
    <material name="joint" rgba="0.95 0.1 0.18 1"/>
  </asset>

  <worldbody>
    <light pos="0 -4 5" dir="0 1 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="side" pos="0 -6.2 1.9" xyaxes="1 0 0 0 0 1"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor"/>
    <geom name="rail" type="box" pos="0 0 1.76" size="2.4 0.025 0.025"
          rgba="0.55 0.58 0.62 1" contype="0" conaffinity="0"/>

    <body name="cart" pos="0 0 1.85">
      <joint name="cart_slide" type="slide" axis="1 0 0" limited="true" range="-2.2 2.2" damping="0.08"/>
      <geom name="cart_box" type="box" size="0.20 0.12 0.08" material="cart" mass="1.0"/>
      <geom name="cart_roof" type="box" pos="0 0 0.092" size="0.13 0.10 0.018" material="cart_trim" contype="0" conaffinity="0"/>
      <geom name="left_eye_white" type="sphere" pos="-0.065 -0.123 0.02" size="0.022" material="eye_white" contype="0" conaffinity="0"/>
      <geom name="right_eye_white" type="sphere" pos="0.065 -0.123 0.02" size="0.022" material="eye_white" contype="0" conaffinity="0"/>
      <geom name="left_eye_dot" type="sphere" pos="-0.065 -0.143 0.017" size="0.010" material="eye_dark" contype="0" conaffinity="0"/>
      <geom name="right_eye_dot" type="sphere" pos="0.065 -0.143 0.017" size="0.010" material="eye_dark" contype="0" conaffinity="0"/>
      <geom name="smile_bar" type="capsule" fromto="-0.055 -0.147 -0.035 0.055 -0.147 -0.035" size="0.008" material="smile" contype="0" conaffinity="0"/>
      <geom name="left_wheel" type="cylinder" pos="-0.11 -0.13 -0.085" axisangle="1 0 0 1.5708"
            size="0.045 0.025" rgba="0.08 0.08 0.08 1"/>
      <geom name="right_wheel" type="cylinder" pos="0.11 -0.13 -0.085" axisangle="1 0 0 1.5708"
            size="0.045 0.025" rgba="0.08 0.08 0.08 1"/>

      <body name="link1" pos="0 0 0.08">
        <joint name="hinge1" type="hinge" axis="0 1 0" limited="false"/>
        <geom type="sphere" size="0.04" material="joint" mass="0.02"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.28" size="0.022" material="link_a" mass="0.10"/>

        <body name="link2" pos="0 0 0.28">
          <joint name="hinge2" type="hinge" axis="0 1 0" limited="false"/>
          <geom type="sphere" size="0.035" material="joint" mass="0.015"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.28" size="0.020" material="link_b" mass="0.09"/>

          <body name="link3" pos="0 0 0.28">
            <joint name="hinge3" type="hinge" axis="0 1 0" limited="false"/>
            <geom type="sphere" size="0.032" material="joint" mass="0.012"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.26" size="0.018" material="link_c" mass="0.08"/>

            <body name="link4" pos="0 0 0.26">
              <joint name="hinge4" type="hinge" axis="0 1 0" limited="false"/>
              <geom type="sphere" size="0.030" material="joint" mass="0.010"/>
              <geom type="capsule" fromto="0 0 0 0 0 0.24" size="0.017" material="link_b" mass="0.07"/>

              <body name="link5" pos="0 0 0.24">
                <joint name="hinge5" type="hinge" axis="0 1 0" limited="false"/>
                <geom type="sphere" size="0.028" material="joint" mass="0.010"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.22" size="0.016" material="link_c" mass="0.06"/>

                <body name="link6" pos="0 0 0.22">
                  <joint name="hinge6" type="hinge" axis="0 1 0" limited="false"/>
                  <geom type="sphere" size="0.026" material="joint" mass="0.008"/>
                  <geom type="capsule" fromto="0 0 0 0 0 0.20" size="0.015" material="link_b" mass="0.05"/>

                  <body name="link7" pos="0 0 0.20">
                    <joint name="hinge7" type="hinge" axis="0 1 0" limited="false"/>
                    <geom type="sphere" size="0.024" material="joint" mass="0.006"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.18" size="0.014" material="link_a" mass="0.04"/>
                    <site name="tip" pos="0 0 0.18" size="0.025" rgba="1 1 1 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="cart_motor" joint="cart_slide" gear="80" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
